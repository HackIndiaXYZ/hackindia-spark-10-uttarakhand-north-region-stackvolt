// AITELLION — Prisma schema
// Multi-tenant, role-based, audited, soft-deleted, UUID-keyed.
// Built by Team StackVolt.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// ENUMS
// ---------------------------------------------------------------------------

enum OrgRole {
  OWNER
  ADMIN
  MANAGER
  HR
  FINANCE
  SALES
  EMPLOYEE
  VIEWER
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  UNQUALIFIED
  CONVERTED
}

enum DealStage {
  PROSPECTING
  QUALIFICATION
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum ActivityType {
  CALL
  EMAIL
  MEETING
  NOTE
  TASK
  STAGE_CHANGE
  AI_ACTION
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

// ---------------------------------------------------------------------------
// TENANCY / IDENTITY
// ---------------------------------------------------------------------------

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  logoUrl   String?
  timezone  String   @default("UTC")
  currency  String   @default("USD")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  memberships OrgMembership[]
  invitations OrgInvitation[]
  customers   Customer[]
  leads       Lead[]
  deals       Deal[]
  pipelines   Pipeline[]
  activities  Activity[]
  notes       Note[]
  tasks       Task[]
  auditLogs   AuditLog[]
  notifications Notification[]
  aiConversations AiConversation[]

  @@map("organizations")
}

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  passwordHash      String?
  fullName          String
  avatarUrl         String?
  isEmailVerified   Boolean   @default(false)
  emailVerifyToken  String?
  emailVerifyExpiresAt DateTime?
  passwordResetToken String?
  passwordResetExpiresAt DateTime?
  googleId          String?   @unique
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  memberships       OrgMembership[]
  refreshTokens     RefreshToken[]
  assignedLeads     Lead[]          @relation("LeadOwner")
  assignedDeals     Deal[]          @relation("DealOwner")
  assignedTasks     Task[]          @relation("TaskAssignee")
  notesAuthored     Note[]          @relation("NoteAuthor")
  activitiesAuthored Activity[]     @relation("ActivityActor")
  auditLogs         AuditLog[]
  notifications     Notification[]
  aiConversations   AiConversation[]

  @@map("users")
}

model OrgMembership {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  role           OrgRole
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("org_memberships")
}

model OrgInvitation {
  id             String       @id @default(uuid())
  organizationId String
  email          String
  role           OrgRole
  token          String       @unique
  status         InviteStatus @default(PENDING)
  invitedById    String?
  expiresAt      DateTime
  createdAt      DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("org_invitations")
}

model RefreshToken {
  id          String    @id @default(uuid())
  userId      String
  tokenHash   String    @unique
  userAgent   String?
  ipAddress   String?
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// CRM
// ---------------------------------------------------------------------------

model Customer {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  company        String?
  email          String?
  phone          String?
  address        String?
  tags           String[]  @default([])
  aiSummary      String?
  aiSummaryAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deals        Deal[]
  activities   Activity[]
  notes        Note[]
  tasks        Task[]

  @@index([organizationId])
  @@map("customers")
}

model Pipeline {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deals        Deal[]

  @@index([organizationId])
  @@map("pipelines")
}

model Lead {
  id             String     @id @default(uuid())
  organizationId String
  name           String
  company        String?
  email          String?
  phone          String?
  source         String?
  status         LeadStatus @default(NEW)
  score          Int?
  ownerId        String?
  convertedCustomerId String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User?        @relation("LeadOwner", fields: [ownerId], references: [id])
  activities   Activity[]

  @@index([organizationId])
  @@index([ownerId])
  @@map("leads")
}

model Deal {
  id             String    @id @default(uuid())
  organizationId String
  pipelineId     String
  customerId     String?
  title          String
  valueCents     Int       @default(0)
  currency       String    @default("USD")
  stage          DealStage @default(PROSPECTING)
  probability    Int       @default(10)
  ownerId        String?
  expectedCloseAt DateTime?
  closedAt       DateTime?
  aiSummary      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pipeline     Pipeline     @relation(fields: [pipelineId], references: [id])
  customer     Customer?    @relation(fields: [customerId], references: [id])
  owner        User?        @relation("DealOwner", fields: [ownerId], references: [id])
  activities   Activity[]
  notes        Note[]
  tasks        Task[]

  @@index([organizationId])
  @@index([pipelineId])
  @@index([customerId])
  @@map("deals")
}

model Activity {
  id             String       @id @default(uuid())
  organizationId String
  type           ActivityType
  summary        String
  metadata       Json?
  actorId        String?
  customerId     String?
  leadId         String?
  dealId         String?
  createdAt      DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?         @relation("ActivityActor", fields: [actorId], references: [id])
  customer     Customer?     @relation(fields: [customerId], references: [id])
  lead         Lead?         @relation(fields: [leadId], references: [id])
  deal         Deal?         @relation(fields: [dealId], references: [id])

  @@index([organizationId])
  @@index([customerId])
  @@index([dealId])
  @@map("activities")
}

model Note {
  id             String    @id @default(uuid())
  organizationId String
  body           String
  authorId       String?
  customerId     String?
  dealId         String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author       User?         @relation("NoteAuthor", fields: [authorId], references: [id])
  customer     Customer?     @relation(fields: [customerId], references: [id])
  deal         Deal?         @relation(fields: [dealId], references: [id])

  @@index([organizationId])
  @@map("notes")
}

model Task {
  id             String     @id @default(uuid())
  organizationId String
  title          String
  description    String?
  status         TaskStatus @default(OPEN)
  dueAt          DateTime?
  assigneeId     String?
  customerId     String?
  dealId         String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignee     User?         @relation("TaskAssignee", fields: [assigneeId], references: [id])
  customer     Customer?     @relation(fields: [customerId], references: [id])
  deal         Deal?         @relation(fields: [dealId], references: [id])

  @@index([organizationId])
  @@index([assigneeId])
  @@map("tasks")
}

// ---------------------------------------------------------------------------
// AI ASSISTANT
// ---------------------------------------------------------------------------

model AiConversation {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  title          String   @default("New conversation")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages     AiMessage[]

  @@index([organizationId])
  @@index([userId])
  @@map("ai_conversations")
}

model AiMessage {
  id             String   @id @default(uuid())
  conversationId String
  role           String   // "user" | "assistant" | "tool"
  content        String
  toolCalls      Json?
  createdAt      DateTime @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("ai_messages")
}

// ---------------------------------------------------------------------------
// PLATFORM
// ---------------------------------------------------------------------------

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String
  actorId        String?
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?         @relation(fields: [actorId], references: [id])

  @@index([organizationId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model Notification {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  title          String
  body           String?
  readAt         DateTime?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}
